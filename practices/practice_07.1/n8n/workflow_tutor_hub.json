      "id": "628ff6a7-a3ab-4383-8792-09706d379443",
      "name": "Not reviewed yet?"
    },
    {
      "parameters": {
        "jsCode": "// n8n Code node «Split diff» (Run Once for All Items).\n// Режет diff на файлы и блоки (hunks) и нумерует строки нового кода,\n// чтобы модель могла сослаться на конкретную строку, а GitHub принял комментарий.\nconst diff = $input.first().json.data || '';\n\nconst valid = {};      // путь файла -> номера добавленных строк (куда можно ставить комментарий)\nconst annotated = [];  // diff с номерами строк для модели\nlet path = null;       // текущий файл\nlet newLine = 0;       // номер строки в новой версии файла\nlet inHunk = false;\n\nfor (const raw of diff.split('\\n')) {\n  if (raw.startsWith('diff --git')) {\n    path = null;\n    inHunk = false;\n    annotated.push('', raw);\n    continue;\n  }\n  if (!inHunk && raw.startsWith('+++ ')) {\n    const p = raw.slice(4).trim();\n    path = p === '/dev/null' ? null : p.replace(/^b\\//, '');\n    if (path) valid[path] = [];\n    annotated.push(raw);\n    continue;\n  }\n  // Заголовок блока: @@ -старт,длина +старт,длина @@\n  const hunk = raw.match(/^@@ -\\d+(?:,\\d+)? \\+(\\d+)(?:,\\d+)? @@/);\n  if (hunk) {\n    newLine = parseInt(hunk[1], 10);\n    inHunk = true;\n    annotated.push(raw);\n    continue;\n  }\n  if (!inHunk || !path) {\n    annotated.push(raw);\n    continue;\n  }\n  if (raw.startsWith('+')) {\n    // добавленная строка: есть в новой версии, на неё можно комментировать\n    valid[path].push(newLine);\n    annotated.push(`L${newLine} ${raw}`);\n    newLine++;\n  } else if (raw.startsWith('-')) {\n    // удалённая строка: в новой версии её нет, номер не растёт\n    annotated.push(`     ${raw}`);\n  } else if (raw.startsWith('\\\\')) {\n    // \"\\ No newline at end of file\" — служебная строка\n  } else {\n    // строка контекста: есть в обеих версиях\n    annotated.push(`L${newLine} ${raw}`);\n    newLine++;\n  }\n}\n\nreturn [{ json: { annotated: annotated.join('\\n').trim(), valid } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1184,
        -16
      ],
      "id": "ba4b291f-f28c-4c85-a5c9-acc0d6ec88cd",
      "name": "Split diff"
    },
    {
      "parameters": {
        "jsCode": "// n8n Code node «Build review» (Run Once for All Items).\n// Берёт JSON-ответ модели, оставляет только комментарии к реально добавленным строкам\n// и собирает тело запроса POST /repos/{owner}/{repo}/pulls/{n}/reviews.\nconst output = $input.first().json.output || '';\nconst valid = $('Split diff').first().json.valid;\nconst meta = $('Get PR meta').first().json;\nconst command = $('PR Trigger1').first().json.body.comment?.body || '';\nconst model = command.includes('/make_other_ai_review')\n  ? 'anthropic/claude-sonnet-4.6'\n  : 'openai/gpt-5.2';\n\n// Модель иногда оборачивает JSON в ```json ... ``` — вырезаем сам объект.\nlet parsed;\ntry {\n  const match = output.match(/\\{[\\s\\S]*\\}/);\n  parsed = JSON.parse(match ? match[0] : output);\n} catch (e) {\n  parsed = { summary: output, comments: [] };\n}\n\nconst comments = [];\nconst skipped = [];\nfor (const c of parsed.comments || []) {\n  const line = Number(c.line);\n  if (valid[c.path] && valid[c.path].includes(line)) {\n    comments.push({ path: c.path, line, side: 'RIGHT', body: c.body });\n  } else {\n    skipped.push(c); // строки нет в diff — GitHub отклонил бы весь запрос\n  }\n}\n\nlet body = `**Модель: ${model}**\\n\\n${parsed.summary || ''}`;\nif (skipped.length) {\n  body += '\\n\\n**Замечания без привязки к строке:**\\n'\n    + skipped.map(c => `- \\`${c.path}:${c.line}\\` — ${c.body}`).join('\\n');\n}\n\nreturn [{\n  json: {\n    url: `${meta.url}/reviews`,\n    inline_count: comments.length,\n    skipped_count: skipped.length,\n    payload: { commit_id: meta.head.sha, body, event: 'COMMENT', comments },\n  },\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
