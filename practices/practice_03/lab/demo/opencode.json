{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/lab03-agent",
  "small_model": "ollama/lab03-agent",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "lab03-agent": {
          "name": "lab03-agent (qwen3.5:27b, num_ctx 16384, temperature 0.2)",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "model": "ollama/lab03-agent",
      "temperature": 0.2,
      "prompt": "{file:./repo-system.txt}",
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    }
  }
}
