    {
      "parameters": {
        "jsCode": "// «Build context»: содержимое файлов (GitHub отдаёт base64) → один текст для модели.\nconst decode = (b64) => {\n  const clean = String(b64 || '').replace(/\\n/g, '');\n  if (typeof Buffer !== 'undefined') return Buffer.from(clean, 'base64').toString('utf8');\n  return new TextDecoder().decode(Uint8Array.from(atob(clean), (c) => c.charCodeAt(0)));\n};\n\nconst files = $input.all().map((item) => ({\n  path: item.json.path,\n  sha: item.json.sha,\n  content: decode(item.json.content),\n}));\n\nconst context = files\n  .map((f) => `### ${f.path}\\n\\`\\`\\`\\n${f.content}\\n\\`\\`\\``)\n  .join('\\n\\n');\n\nreturn [{\n  json: {\n    files: files.map(({ path, sha }) => ({ path, sha })),\n    context,\n  },\n}];\n"
      },
